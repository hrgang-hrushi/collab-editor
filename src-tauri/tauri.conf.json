{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Crux",
  "version": "0.1.0",
  "identifier": "com.crux.ide",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Crux",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/Crex.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "dmg": {
        "background": "icons/background.tiff",
        "windowSize": {
          "width": 800,
          "height": 400
        },
        "appPosition": {
          "x": 200,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 600,
          "y": 200
        }
      }
    }
  }
}

