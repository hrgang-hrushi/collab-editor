{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Crux",
  "version": "0.1.0",
  "identifier": "com.crux.ide",
  "build": {
    "frontendDist": "../.next-prod",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI_BUILD=1 npm run build:export"
  },
  "app": {
    "windows": [
      {
        "title": "Crux",
        "url": "ide.html",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "../public/crux-dmg-background.png",
        "windowSize": {
          "width": 800,
          "height": 432
        },
        "appPosition": {
          "x": 180,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 620,
          "y": 205
        }
      }
    }
  }
}
